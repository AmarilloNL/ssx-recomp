+  // Only small resolves, when limited: games often read only tiny render targets on the CPU, and
+  // reading back the big ones each frame (written ranges are conservative) is what costs and breaks.
+  if (int32_t max_size = REXCVAR_GET(readback_resolve_max_size);
+      max_size > 0 && written_length > uint32_t(max_size)) {
+    return true;
+  }
+
   bool is_scaled = texture_cache_->IsDrawResolutionScaled();
   uint64_t resolve_key = MakeReadbackResolveKey(written_address, written_length);
   ReadbackBuffer& readback = readback_buffers_[resolve_key];
