+void TextureCache::VolumeGlobalWatchCallbackThunk(
+    const std::unique_lock<std::recursive_mutex>& global_lock, void* context,
+    uint32_t address_first, uint32_t address_last, bool invalidated_by_gpu) {
+  for (Texture* texture : static_cast<TextureCache*>(context)->volume_textures_) {
+    uint32_t base = texture->key().base_page << 12;
+    uint32_t last = base + texture->GetGuestBaseSize() - 1;
+    if (address_first <= last && address_last >= base) {
+      texture->ExtendVolumeDirtyRange(std::max(address_first, base) - base,
+                                      std::min(address_last, last) - base);
+    }
+  }
+}
