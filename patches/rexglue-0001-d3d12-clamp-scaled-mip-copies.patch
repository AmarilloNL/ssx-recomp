+              width, height, texture_resolution_scaled, uint32_t(guest_format));
+        }
+        source_box.right = source_box.left + std::min(copy_width, dst_width);
+        source_box.bottom = source_box.top + std::min(copy_height, dst_height);
+        source_box.back = source_box.front + std::min(copy_depth, dst_depth);
+        source_box_ptr = &source_box;
+      }
+    }
     for (uint32_t slice = 0; slice < array_size; ++slice) {
