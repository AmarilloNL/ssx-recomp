+      }
+      uint32_t copy_width = source_box.right - source_box.left;
+      uint32_t copy_height = source_box.bottom - source_box.top;
+      uint32_t copy_depth = source_box.back - source_box.front;
+      if (copy_width > dst_width || copy_height > dst_height || copy_depth > dst_depth) {
