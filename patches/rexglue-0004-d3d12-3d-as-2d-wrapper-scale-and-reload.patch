--- a/src/graphics/d3d12/texture_cache.cpp
+++ b/src/graphics/d3d12/texture_cache.cpp
@@ -2021,6 +2021,11 @@
   auto& d3d12_cache = static_cast<D3D12TextureCache&>(texture_cache());
 
   if (texture_3d_as_2d_) {
+    // The wrapper watches the guest memory like any texture; reload it when that
+    // changed (a render target resolved there again), or it keeps its first contents.
+    if (!d3d12_cache.LoadTextureData(*texture_3d_as_2d_)) {
+      REXGPU_ERROR("D3D12TextureCache: Failed to reload 3D-as-2D wrapper data");
+    }
     d3d12_cache.command_processor_.PushTransitionBarrier(
         texture_3d_as_2d_->resource(), texture_3d_as_2d_->SetResourceState(end_state), end_state);
     return texture_3d_as_2d_->resource();
@@ -2034,6 +2039,10 @@
   desc.Alignment = 0;
