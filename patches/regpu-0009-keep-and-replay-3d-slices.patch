+// Copies a kept slice into slice z of a volume that is in the COPY_DEST state.
+void CopyVolumeSlice(CachedTexture& v, uint32_t z, const VolumeSlice& slice)
+{
+    D3D12_RESOURCE_BARRIER b{};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = slice.texture.Get();
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    C().list->ResourceBarrier(1, &b);
+    D3D12_TEXTURE_COPY_LOCATION dst{}, src{};
+    dst.pResource = v.resource.Get();
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = slice.texture.Get();
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    C().list->CopyTextureRegion(&dst, 0, 0, z, &src, nullptr);
+    std::swap(b.Transition.StateBefore, b.Transition.StateAfter);
+    C().list->ResourceBarrier(1, &b);
+    g_volumeSlices++;
+}
+
+// The slice of a volume a resolve destination is (8 slices to a group of the destination base), or ~0u.
+uint32_t VolumeSliceIndex(const CachedTexture& v, uint32_t destBase, uint32_t slice, const VolumeSlice& kept)
+{
+    // Note: 32-bit texels only (RGBA8 volumes); others keep the memory path.
+    if (!v.resource || v.format != DXGI_FORMAT_R8G8B8A8_UNORM || destBase < v.address || kept.width != v.width || kept.height != v.height)
+        return ~0u;
+    const uint32_t groupBytes = v.width * v.height * 4 * 8, offset = destBase - v.address;
+    const uint32_t z = offset / groupBytes * 8 + slice;
+    return offset % groupBytes || z >= v.depth ? ~0u : z;
+}
+
+// Every kept slice of a volume (in the COPY_DEST state), after it was decoded from guest memory.
+void ReplayVolumeSlices(CachedTexture& v)
+{
+    for (const auto& [key, kept] : g_volumeSliceStore)
+        if (const uint32_t z = VolumeSliceIndex(v, uint32_t(key >> 3), uint32_t(key & 7), kept); z != ~0u)
+            CopyVolumeSlice(v, z, kept);
+}
