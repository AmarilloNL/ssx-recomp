--- a/src/gpu/hlsl.cpp
+++ b/src/gpu/hlsl.cpp
@@ -295,6 +295,27 @@ float2 Mirror(float2 uv, uint info)
     return uv;
 }
 
+// The declared image inside a wider resolved texture (tbias.zw: its share of the texture, renderer.cpp).
+// The texture's own edge is the pitch's padding, and the copy's rectangle fills part of that with
+// whatever the EDRAM held there: the console's sampler never reaches it, it stops (or wraps) at the
+// declared image's last texel. Sampled up to the texture's edge, SSX's 300x160 blur images (304 columns
+// copied, the last four a strip of the full-size scene) drew a light line down the right of the screen,
+// and the speed blur spread it into stripes. A negative share: scaled only, as before (A/B).
+float2 PaddedCoord(uint slot, float2 uv, float2 texelSize)
+{
+    const float2 pad = tbias[slot].zw;
+    if (pad.x == 0.0) return uv;
+    if (pad.x > 0.0)
+    {
+        const uint info = tinfo[slot].x;
+        const bool wraps = (info & 3u) == 0u || (info & 3u) == 3u;
+        const float2 lo = 0.5 / texelSize, hi = 1.0 - lo;
+        if (pad.x < 1.0) uv.x = clamp(wraps && ((info >> 18) & 1u) == 0u ? frac(uv.x) : uv.x, lo.x, hi.x);
+        if (pad.y < 1.0) uv.y = clamp(wraps && ((info >> 19) & 1u) == 0u ? frac(uv.y) : uv.y, lo.y, hi.y);
+    }
+    return uv * abs(pad);
+}
+
 float4 TFetchRaw(uint slot, float3 coord, bool denorm, bool vertexStage, float bias, float2 texel)
 {
     uint index = asuint(tbias[slot].y);
@@ -332,7 +353,7 @@ float4 TFetchRaw(uint slot, float3 coord, bool denorm, bool vertexStage, float b
     // the edge texels' centres; the sampler wraps.
     if ((tinfo[slot].x >> 18) & 1u) uv.x = clamp(uv.x, 0.5 / texelSize.x, 1.0 - 0.5 / texelSize.x);
     if ((tinfo[slot].x >> 19) & 1u) uv.y = clamp(uv.y, 0.5 / texelSize.y, 1.0 - 0.5 / texelSize.y);
-    if (tbias[slot].z > 0.0) uv *= tbias[slot].zw; // declared image inside a wider resolved texture (renderer.cpp)
+    uv = PaddedCoord(slot, uv, texelSize);
     uint mode = FetchMode(tinfo[slot].x & 3u);
     // Vertex shaders read data tables this way (PGR4's riders: bone matrices, three texels a bone):
     // the fetch constant's filter applies, point sampling exactly one texel. Always linear here,
@@ -1090,7 +1111,7 @@ float4 TFetch2D(uint slot, float3 coord, bool denorm, float bias, float2 texel)
         return ((info >> 17) & 1u) ? float4(1, 1, 1, 1) : float4(0, 0, 0, 0);
     if ((info >> 18) & 1u) uv.x = clamp(uv.x, 0.5 / texelSize.x, 1.0 - 0.5 / texelSize.x);
     if ((info >> 19) & 1u) uv.y = clamp(uv.y, 0.5 / texelSize.y, 1.0 - 0.5 / texelSize.y);
-    if (tbias[slot].z > 0.0) uv *= tbias[slot].zw;
+    uv = PaddedCoord(slot, uv, texelSize);
     // Sampler index: the filter mode (1-3 its own sampler), else the anisotropy (s4-s7), else s0.
     const uint mode = info & 3u, aniso = (info >> 20) & 7u;
     const uint s = mode != 0u ? mode : (aniso >= 1u && aniso <= 4u ? aniso + 3u : 0u);
