-// A "V" line's runtime shader rebuilt from its shipped one; false if the line doesn't fit (the hash checks it).
+// An "F" line's patched fetch: the vertex declaration fields written into the shipped shader's vertex fetch at
+// that slot (natural bit order, after the byte swap): data format, stride, offset, destination swizzle, prefetch
+// count and the format flags, and where the declaration moves an element the destination register and the
+// fetch constant selector. No instruction words.
+void SetFetchFields(uint32_t* slotBE, unsigned format, unsigned stride, unsigned offset, unsigned swizzle, unsigned prefetch,
+                    unsigned flags, int reg, int sel)
+{
+    auto put = [](uint32_t& w, int shift, int bits, uint32_t v) {
+        const uint32_t m = ((1u << bits) - 1) << shift;
+        w = (w & ~m) | ((v << shift) & m);
+    };
+    uint32_t w[3];
+    for (int k = 0; k < 3; k++)
+        w[k] = __builtin_bswap32(slotBE[k]);
+    put(w[0], 27, 3, prefetch);
+    if (reg >= 0)
+    {
+        put(w[0], 12, 6, uint32_t(reg));
+        put(w[0], 25, 2, uint32_t(sel));
+    }
+    put(w[1], 0, 12, swizzle);
+    put(w[1], 12, 1, flags & 1);        // format_comp_all (signed)
+    put(w[1], 13, 1, (flags >> 1) & 1); // num_format_all (integer)
+    put(w[1], 16, 6, format);
+    put(w[1], 30, 1, (flags >> 2) & 1); // is_mini_fetch
+    put(w[2], 0, 8, stride);
+    put(w[2], 8, 23, offset);
+    for (int k = 0; k < 3; k++)
+        slotBE[k] = __builtin_bswap32(w[k]);
+}
