+// CopyTextureBlocks with the block size fixed at compile time: the copies and the swap become a few
+// instructions. With the size at run time every block cost two memcpy calls and a Swap call: a
+// 1268x1280 k_16 image (1.6 million 2-byte blocks) re-uploaded each frame took 25-30 ms. Each row
+// is assembled here and written to dst in one go (upload memory: write-combined, never read).
+template <uint32_t BlockBytes>
+void CopyBlocks(const TextureFetch& fetch, const uint8_t* source, uint8_t* dst, uint32_t dstRowPitch, uint32_t blocksX, uint32_t blocksY,
+    uint32_t pitchBlocks, uint32_t log2Bytes, uint32_t packX, uint32_t packY)
+{
+    const uint32_t endian = fetch.Endian();
+    const bool tiled = fetch.Tiled();
+    thread_local std::vector<uint8_t> row;
+    row.resize(size_t(blocksX) * BlockBytes);
+    for (uint32_t by = 0; by < blocksY; by++)
+    {
+        const int32_t rowOffset = tiled ? TiledOffset2DOuter(by + packY, pitchBlocks, log2Bytes) : 0;
+        for (uint32_t bx = 0; bx < blocksX; bx++)
+        {
+            const size_t offset = tiled ? size_t(TiledOffset2DInner(bx + packX, by + packY, log2Bytes, rowOffset) >> log2Bytes) * BlockBytes
+                                        : (size_t(by + packY) * pitchBlocks + bx + packX) * BlockBytes;
+            uint8_t* block = row.data() + size_t(bx) * BlockBytes;
+            memcpy(block, source + offset, BlockBytes);
+            Swap(block, BlockBytes, endian);
+        }
+        memcpy(dst + size_t(by) * dstRowPitch, row.data(), row.size());
+    }
+}
