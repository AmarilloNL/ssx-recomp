+// DecodeTexture's texel formats (one texel a block) with the block size fixed at compile time: the
+// copy and the swap become a few instructions (with the size at run time, a 1024x1024 k_8 atlas the
+// title updates often took ~15 ms to decode).
+template <uint32_t BlockBytes>
+void DecodeTexels(const TextureFetch& fetch, const uint8_t* source, uint8_t* rgba, uint32_t width, uint32_t height, uint32_t pitchBlocks,
+    uint32_t log2Bytes, uint32_t packX, uint32_t packY)
+{
+    const uint32_t format = fetch.Format(), endian = fetch.Endian();
+    const bool tiled = fetch.Tiled();
+    for (uint32_t y = 0; y < height; y++)
+    {
+        const int32_t rowOffset = tiled ? TiledOffset2DOuter(y + packY, pitchBlocks, log2Bytes) : 0;
+        uint8_t* out = rgba + size_t(y) * width * 4;
+        for (uint32_t x = 0; x < width; x++, out += 4)
+        {
+            const size_t offset = tiled ? size_t(TiledOffset2DInner(x + packX, y + packY, log2Bytes, rowOffset) >> log2Bytes) * BlockBytes
+                                        : (size_t(y + packY) * pitchBlocks + x + packX) * BlockBytes;
+            uint8_t block[BlockBytes];
+            memcpy(block, source + offset, BlockBytes);
+            Swap(block, BlockBytes, endian);
+            DecodeTexel(format, block, out);
+        }
+    }
+}
