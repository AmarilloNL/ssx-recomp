+// Per-component logic: HLSL 2021 (DXC, the Linux build) wants select/and/or for vectors, fxc the
+// operators. Same result either way.
+#if defined(__HLSL_VERSION) && __HLSL_VERSION >= 2021
+#define REGPU_SEL(c, a, b) select(c, a, b)
+#define REGPU_AND(a, b) and(a, b)
+#define REGPU_OR(a, b) or(a, b)
+#else
+#define REGPU_SEL(c, a, b) ((c) ? (a) : (b))
+#define REGPU_AND(a, b) ((a) && (b))
+#define REGPU_OR(a, b) ((a) || (b))
+#endif
