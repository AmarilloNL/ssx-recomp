+// The vertex shader a recorded pipeline key was built with: its user clip plane variant when the key
+// has that bit (0x800, GetPipeline), so the manifest and the title's pipeline list rebuild those
+// pipelines too. Null when the variant can't be made.
+const CompiledShader* KeyVertexShader(const CompiledShader& vs, const PipelineKey& key)
+{
+    return (key.flags & 0x800) && !vs.userClip ? ClipShader(vs) : &vs;
+}
 
