+// A resolve into a 3D texture (RB_COPY_DEST_INFO bit 3, the slice in bits 4-6 of an 8-slice group at the
+// destination base): the console writes the slice into the volume's memory, which the title then samples
+// as a 3D texture. Volumes are decoded from guest memory here, so the resolved image is drawn into the slice
+// of every cached volume at that address instead (averaged down to the volume's size). SSX's snow trails: a
+// simulation resolves into slices of a 128x128x256 trail volume every frame, and without this the snow
+// showed no tracks. REGPU_NO_RESOLVE_TO_3D=1: off.
+void ResolveIntoVolumes(uint32_t destBase, uint32_t slice, uint32_t srcBase, bool swapRB)
+{
+    static LiveSwitch off("REGPU_NO_RESOLVE_TO_3D");
+    if (off)
+        return;
+    const auto found = g_r.resolved.find(srcBase);
+    if (found == g_r.resolved.end() || !found->second.resource)
+        return;
+    ResolvedTexture& src = found->second;
+    std::lock_guard<std::recursive_mutex> lock{ g_textureMutex };
+    for (auto& [key, v] : g_r.volumes)
+    {
+        // Note: 32-bit texels only (RGBA8 volumes); others keep the memory path.
+        if (!v.resource || v.rtvFirst == ~0u || v.format != DXGI_FORMAT_R8G8B8A8_UNORM || destBase < v.address)
+            continue;
+        const uint32_t groupBytes = v.width * v.height * 4 * 8, offset = destBase - v.address;
+        const uint32_t z = offset / groupBytes * 8 + slice;
+        if (offset % groupBytes || z >= v.depth)
+            continue;
+        FrameResources& f = Frame();
+        if (f.descriptorsUsed >= kDescriptorsPerFrame)
+            return;
+        const UINT slot = f.descriptorBase + f.descriptorsUsed++;
+        D3D12_SHADER_RESOURCE_VIEW_DESC srv{};
+        srv.Format = src.resource->GetDesc().Format;
+        srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        srv.Texture2D.MipLevels = 1;
+        g_r.device->CreateShaderResourceView(src.resource.Get(), &srv, Cpu(g_r.srvHeap.Get(), slot, g_r.srvStride));
+        D3D12_RESOURCE_BARRIER b{};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = v.resource.Get();
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        C().list->ResourceBarrier(1, &b);
+        const D3D12_CPU_DESCRIPTOR_HANDLE rtv = Cpu(g_volumeRtvs.heap.Get(), v.rtvFirst + z, g_volumeRtvs.stride);
+        C().list->OMSetRenderTargets(1, &rtv, FALSE, nullptr);
+        C().list->SetGraphicsRootSignature(g_r.blitRootSignature.Get());
+        C().list->SetPipelineState(g_r.colorBlit8.Get());
+        C().list->SetGraphicsRootDescriptorTable(0, Gpu(g_r.srvHeap.Get(), slot, g_r.srvStride));
+        const uint32_t blockX = std::max(1u, src.hostWidth / v.width), blockY = std::max(1u, src.hostHeight / v.height);
+        // Stored as the copy holds it: a volume is decoded with its fetch's swizzle applied, which undoes the
+        // copy's red/blue swap (SSX's trail normals came out sideways, dark, when stored swapped).
+        static LiveSwitch swapped("REGPU_RESOLVE_TO_3D_SWAPPED"); // A/B: stored swapped, as in memory
+        const uint32_t constants[8] = { std::bit_cast<uint32_t>(1.0f), uint32_t(swapRB && swapped), 0, 0, 0, 0, blockX, blockY };
+        C().list->SetGraphicsRoot32BitConstants(1, 8, constants, 0);
+        const D3D12_VIEWPORT vp{ 0, 0, float(v.width), float(v.height), 0, 1 };
+        const D3D12_RECT sc{ 0, 0, LONG(v.width), LONG(v.height) };
+        C().list->RSSetViewports(1, &vp);
+        C().list->RSSetScissorRects(1, &sc);
+        C().list->DrawInstanced(3, 1, 0, 0);
+        g_volumeSlices++;
+        LogVolumeActivity();
+        std::swap(b.Transition.StateBefore, b.Transition.StateAfter);
+        C().list->ResourceBarrier(1, &b);
+        C().list->OMSetRenderTargets(1, &C().rtv, FALSE, &C().dsv);
+        C().list->SetGraphicsRootSignature(g_r.rootSignature.Get());
+        g_drawState.Invalidate();
+    }
+}
