+// User clip plane variant of a vertex shader: each vertex's distance to the planes (vucp, filled per
+// draw in DrawImpl) as clip distances. Only draws with planes on use it (UserClipOn); the outputs cost
+// every other draw ~4% of the frame. Empty when the text is not in the expected shape.
+std::string ClipVariant(const std::string& hlsl, bool pixel)
+{
+    std::string h = hlsl;
+    const std::string out = "    float2 pcoord : TEXCOORD16; // point sprite coordinate\n";
+    const std::string at = "    float2 size = float2(vinfo.zw);\n";
+    const size_t o = h.find(out);
+    if (pixel || o == std::string::npos)
+        return {};
+    h.insert(o + out.size(), "    float4 clip0 : SV_ClipDistance0; // planes 0-3, negative is cut away\n"
+                             "    float2 clip1 : SV_ClipDistance1; // and 4-5\n");
+    const size_t a = h.find(at);
+    if (a == std::string::npos)
+        return {};
+    // The clip-space position, with any divide by w the shader asked for undone (as Xenia does).
+    h.insert(a, "    {\n"
+                "        float4 cp = r.pos;\n"
+                "        if (vte.x & (1u << 8)) cp.xy *= cp.w;\n"
+                "        if (vte.x & (1u << 9)) cp.z *= cp.w;\n"
+                "        r.clip0 = float4(dot(cp, vucp[0]), dot(cp, vucp[1]), dot(cp, vucp[2]), dot(cp, vucp[3]));\n"
+                "        r.clip1 = float2(dot(cp, vucp[4]), dot(cp, vucp[5]));\n"
+                "    }\n");
+    return h;
+}
+
+// User clip planes: PA_CL_CLIP_CNTL bits 0-5 enable PA_CL_UCP_n (registers 0x2388 + 4n, x y z w in clip
+// space), unless CLIP_DISABLE (bit 16). SSX cuts the snow ribbon along its rails with plane 0; without
+// it the whole ribbon stood around every rail as a white band. REGPU_NO_USER_CLIP=1: none, as before.
+// ponytail: UCP_CULL_ONLY_ENA (bit 17: whole primitives culled, none clipped) is left off, as before; a
+// cull distance output if a title needs it.
+bool UserClipOn()
+{
+    static LiveSwitch noUserClip("REGPU_NO_USER_CLIP");
+    const uint32_t c = gpureg::Get(0x2204 /* PA_CL_CLIP_CNTL */);
+    return !noUserClip && (c & 0x3F) && !((c >> 16) & 1) && !((c >> 17) & 1);
