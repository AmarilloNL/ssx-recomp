+bool D3D12RenderTargetCache::UpdateDrawEdramUnscaled(reg::RB_DEPTHCONTROL normalized_depth_control,
+                                                     uint32_t normalized_color_mask) {
+  if (!edram_unscaled_depth_pitch_) {
+    return false;
+  }
+  bool depth_used = normalized_depth_control.z_enable || normalized_depth_control.stencil_enable;
+  if (!normalized_color_mask && !depth_used) {
+    // Doesn't access the EDRAM.
+    return false;
+  }
+  const RegisterFile& regs = register_file();
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  uint32_t pitch_samples =
+      rb_surface_info.surface_pitch *
+      (rb_surface_info.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1);
+  unscaled_pass_active_ = !normalized_color_mask && pitch_samples == edram_unscaled_depth_pitch_;
+  if (unscaled_pass_active_) {
+    unscaled_pass_depth_base_tiles_ = regs.Get<reg::RB_DEPTH_INFO>().depth_base;
+    unscaled_pass_pitch_tiles_ = xenos::GetSurfacePitchTiles(rb_surface_info.surface_pitch,
+                                                             rb_surface_info.msaa_samples, false);
+  }
+  return unscaled_pass_active_;
+}
