diff --git a/src/graphics/shaders/texture_load_direct_scaled.cs.hlsl b/src/graphics/shaders/texture_load_direct_scaled.cs.hlsl
new file mode 100644
index 0000000..5563b61
--- /dev/null
+++ b/src/graphics/shaders/texture_load_direct_scaled.cs.hlsl
@@ -0,0 +1,98 @@
+// Build (Windows SDK fxc), with the .xesli includes from Xenia commit
+// 95a5c3ee250f80c3b9d139658649d9ffb6db3eec (src/xenia/gpu/shaders, ui/shaders/xesl.xesli):
+//   fxc /T cs_5_1 /E main /D SHADING_LANGUAGE_HLSL_XE=1 /D XE_DIRECT_FORMAT=<0|1|2> /O3
+//       /Vn texture_load_direct_<rgba8|depth_float|rgba16f>_scaled_cs
+//       /Fh bytecode/d3d12_5_1/texture_load_direct_<...>_scaled_cs.h
+//       texture_load_direct_scaled.cs.hlsl
+//
+// Resolution-scaled texture loads that write straight into the host texture through a typed UAV,
+// instead of into a buffer that is then copied into the texture (at 4x a full-screen 32bpp
+// texture is 49 MB, so the copy costs as much as the load). Same endian swap and conversions as
+// Xenia's texture_load_32bpb / 64bpb / depth_float scaled shaders (BSD license, Copyright 2022
+// Ben Vanik), built from their .xesli files; the scaled source addressing follows this SDK's
+// layout (XeDirectSourceAddress).
+//
+// XE_DIRECT_FORMAT:
+//   0 - 32bpb into an R8G8B8A8_UINT view (k_8_8_8_8, typeless resource), 8 blocks per thread.
+//   1 - k_24_8_FLOAT depth into R32_FLOAT, 8 blocks per thread.
+//   2 - 64bpb into R16G16B16A16_FLOAT (k_16_16_16_16_FLOAT), 4 blocks per thread.
+
+#define XE_TEXTURE_LOAD_RESOLUTION_SCALED
+#include "texture_load.xesli"
+#include "pixel_formats.xesli"
+
+Buffer<uint4> xe_texture_load_source : register(t0, space0);
+
+#if XE_DIRECT_FORMAT == 0
+RWTexture2D<uint4> xe_texture_load_dest : register(u0, space0);
+#define XE_DIRECT_BLOCKS_PER_THREAD_LOG2 3u
+#define XE_DIRECT_BYTES_PER_BLOCK_LOG2 2u
+#elif XE_DIRECT_FORMAT == 1
+RWTexture2D<float> xe_texture_load_dest : register(u0, space0);
+#define XE_DIRECT_BLOCKS_PER_THREAD_LOG2 3u
+#define XE_DIRECT_BYTES_PER_BLOCK_LOG2 2u
+#else
+RWTexture2D<float4> xe_texture_load_dest : register(u0, space0);
+#define XE_DIRECT_BLOCKS_PER_THREAD_LOG2 2u
+#define XE_DIRECT_BYTES_PER_BLOCK_LOG2 3u
+#endif
+
+// Source address of host (resolution-scaled) block position in the scaled resolve memory layout
+// of this SDK (Xenia before 2022-06): each 16-byte x 1-row group of guest blocks is stored as
+// scale_x * scale_y host groups of 16 bytes x 1 row, column-major. (Current Xenia uses larger
+// groups - XeniaTextureGetResolutionScaledAddressing - so it can not be used here.)
+uint XeDirectSourceAddress(XeTextureLoadInfo load_info, uint2 host_position, uint bpb_log2) {
+  uint group_blocks_log2 = 4u - bpb_log2;
+  uint2 scale = load_info.resolution_scale;
+  uint host_group_x = host_position.x >> group_blocks_log2;
+  uint guest_group_x = host_group_x / scale.x;
+  uint guest_y = host_position.y / scale.y;
+  uint2 host_group_in_guest_group =
+      uint2(host_group_x - guest_group_x * scale.x, host_position.y - guest_y * scale.y);
+  uint address = uint(XenosTextureTiledAddress2D(
+      int2(guest_group_x << group_blocks_log2, guest_y),
+      load_info.guest_pitch_aligned >> XENOS_TEXTURE_MACRO_TILE_WIDTH_LOG2, bpb_log2));
+  address = address * (scale.x * scale.y) +
+            ((host_group_in_guest_group.x * scale.y + host_group_in_guest_group.y) << 4u) +
+            ((host_position.x & ((1u << group_blocks_log2) - 1u)) << bpb_log2);
+  return address + load_info.guest_offset;
+}
+
+// Stores the 16 bytes loaded from one guest address (4 blocks of 32bpb, 2 blocks of 64bpb),
+// with the leftmost block at position.
+void XeDirectStore(uint2 position, uint4 blocks) {
+#if XE_DIRECT_FORMAT == 0
+  [unroll] for (uint i = 0u; i < 4u; ++i) {
+    xe_texture_load_dest[position + uint2(i, 0u)] =
+        (uint4(blocks[i], blocks[i], blocks[i], blocks[i]) >> uint4(0u, 8u, 16u, 24u)) & 0xFFu;
+  }
+#elif XE_DIRECT_FORMAT == 1
+  uint4 depth32 = XeFloat20e4To32(blocks >> 8u);
+  [unroll] for (uint i = 0u; i < 4u; ++i) {
+    xe_texture_load_dest[position + uint2(i, 0u)] = asfloat(depth32[i]);
+  }
+#else
+  xe_texture_load_dest[position] =
+      f16tof32(uint4(blocks.x, blocks.x >> 16u, blocks.y, blocks.y >> 16u));
+  xe_texture_load_dest[position + uint2(1u, 0u)] =
+      f16tof32(uint4(blocks.z, blocks.z >> 16u, blocks.w, blocks.w >> 16u));
+#endif
+}
+
+[numthreads(LOCAL_SIZE_X_XE, LOCAL_SIZE_Y_XE, LOCAL_SIZE_Z_XE)]
+void main(uint3 xe_thread_id : SV_DispatchThreadID) {
+  XeTextureLoadInfo load_info = XeTextureLoadGetInfo();
+  uint3 block_index = xe_thread_id << uint3(XE_DIRECT_BLOCKS_PER_THREAD_LOG2, 0u, 0u);
+  [branch] if (any(block_index.xy >= load_info.size_blocks.xy)) {
+    return;
+  }
+  // Two 16-byte groups: 2 x 4 blocks of 32bpb or 2 x 2 blocks of 64bpb.
+  uint group_blocks = 16u >> XE_DIRECT_BYTES_PER_BLOCK_LOG2;
+  [unroll] for (uint i = 0u; i < 2u; ++i) {
+    uint2 position = block_index.xy + uint2(group_blocks * i, 0u);
+    uint source_address =
+        XeDirectSourceAddress(load_info, position, XE_DIRECT_BYTES_PER_BLOCK_LOG2);
+    XeDirectStore(position, XeEndianSwap32(xe_texture_load_source[source_address >> 4u],
+                                           load_info.endian_32));
+  }
+}
