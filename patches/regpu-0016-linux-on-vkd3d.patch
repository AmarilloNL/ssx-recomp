+// Linux output (render/presenter.h): ReGPU's frames on the host's window through Vulkan.
+//
+// vkd3d (Direct3D 12 on Vulkan) runs the renderer. The back buffers are Vulkan images that vkd3d
+// wraps as D3D12 resources, so the renderer copies each frame into them as on Windows
+// (PresenterRecordCopy). PresenterPresent hands the buffer to a presenter thread, which waits for
+// the frame on the GPU, stretches it onto the window's swap chain (DXGI's stretch on Windows) and
+// presents it. Only the host-window case exists here: the plugin always gives ReGPU its window
+// (Config::createVulkanSurface).
+#include <windows.h>
+#include <d3d12.h>
+#include <wrl/client.h>
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "log.h"
+#include "regpu/regpu.h"
+#include "render/presenter.h"
+#include "settings.h"
+
+using Microsoft::WRL::ComPtr;
+
+namespace
+{
+constexpr UINT kBuffers = 3;
+constexpr VkFormat kBackFormat = VK_FORMAT_R8G8B8A8_UNORM;
+
+void Check(HRESULT hr, const char* what)
+{
+    if (FAILED(hr))
+        Fatal("presenter: %s failed (%08lX)", what, long(hr));
+}
+void CheckVk(VkResult r, const char* what)
+{
+    if (r != VK_SUCCESS)
+        Fatal("presenter: %s failed (VkResult %d)", what, int(r));
+}
+
+std::mutex g_deviceMutex;
+ComPtr<ID3D12Device> g_device;
+ComPtr<ID3D12CommandQueue> g_queue;
+struct vkd3d_instance* g_instance = nullptr;
+
+struct BackBuffer
+{
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    ComPtr<ID3D12Resource> resource;
+    uint64_t frameFence = 0;          // D3D12 fence value of the frame drawn into it
+    VkCommandBuffer cmd = VK_NULL_HANDLE;
+    VkFence blitDone = VK_NULL_HANDLE; // its last stretch onto the swap chain finished
+    bool blitPending = false;
+    VkSemaphore acquired = VK_NULL_HANDLE;
+};
+
+struct Presenter
+{
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice physical = VK_NULL_HANDLE;
+    VkDevice vk = VK_NULL_HANDLE;
+    uint32_t family = 0;
+    VkSurfaceKHR surface = VK_NULL_HANDLE;
+    VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+    VkFormat swapFormat = VK_FORMAT_UNDEFINED;
+    VkExtent2D swapExtent{};
+    std::vector<VkImage> swapImages;
+    std::vector<VkSemaphore> rendered; // per swap chain image
+    bool swapVsync = true;
+    VkCommandPool pool = VK_NULL_HANDLE;
+
+    uint32_t width = 0, height = 0; // back buffers (the output resolution)
+    BackBuffer back[kBuffers];
+    ComPtr<ID3D12DescriptorHeap> rtvHeap;
+    UINT rtvStride = 0;
+    ComPtr<ID3D12Fence> fence;
+    uint64_t nextFence = 1;
+    HANDLE fenceEvent = nullptr;
+    UINT current = 0;
+
+    std::mutex mutex; // pending, and the back buffers' blit state
+    std::condition_variable cv;
+    std::deque<UINT> pending;
+    int presenting = -1; // taken off pending, its stretch not submitted yet
+    std::atomic<bool> ready{ false };
+};
+Presenter g_p;
+
+void EnsureDevice()
+{
+    std::lock_guard lock(g_deviceMutex);
+    if (g_device)
+        return;
+    const Settings& settings = GetSettings();
+    std::vector<const char*> instanceExtensions = settings.vulkanInstanceExtensions;
+    const bool window = settings.createVulkanSurface && !getenv("REGPU_HEADLESS");
+    if (!window)
+        instanceExtensions.clear();
+
+    vkd3d_instance_create_info ii{};
+    ii.type = VKD3D_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+    ii.pfn_signal_event = vkd3d_signal_event;
+    ii.wchar_size = sizeof(WCHAR);
+    ii.instance_extensions = instanceExtensions.data();
+    ii.instance_extension_count = uint32_t(instanceExtensions.size());
+    Check(vkd3d_create_instance(&ii, &g_instance), "vkd3d_create_instance");
+
+    static const char* const deviceExtensions[] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME };
+    vkd3d_device_create_info di{};
+    di.type = VKD3D_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
+    // 11_0: vkd3d reports 12_0 only with tiled resources, which it doesn't implement and ReGPU
+    // doesn't use. What ReGPU does need (bindless tables, typed UAV loads) it checks itself.
+    di.minimum_feature_level = D3D_FEATURE_LEVEL_11_0;
+    di.instance = g_instance;
+    di.device_extensions = window ? deviceExtensions : nullptr;
+    di.device_extension_count = window ? 1u : 0u;
+    Check(vkd3d_create_device(&di, __uuidof(ID3D12Device), reinterpret_cast<void**>(g_device.ReleaseAndGetAddressOf())), "vkd3d_create_device");
+    D3D12_COMMAND_QUEUE_DESC qd{};
+    qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    Check(g_device->CreateCommandQueue(&qd, IID_PPV_ARGS(&g_queue)), "CreateCommandQueue");
+    Log("presenter: vkd3d device on Vulkan");
+}
+
+uint32_t MemoryType(uint32_t bits, VkMemoryPropertyFlags flags)
+{
+    VkPhysicalDeviceMemoryProperties props;
+    vkGetPhysicalDeviceMemoryProperties(g_p.physical, &props);
+    for (uint32_t i = 0; i < props.memoryTypeCount; i++)
+        if ((bits & (1u << i)) && (props.memoryTypes[i].propertyFlags & flags) == flags)
+            return i;
+    Fatal("presenter: no Vulkan memory type for the back buffers");
+    return 0;
+}
+
+// Waits until no stretch reads back buffer i any more.
+void WaitBlit(BackBuffer& b)
+{
+    if (b.blitPending)
+    {
+        vkWaitForFences(g_p.vk, 1, &b.blitDone, VK_TRUE, UINT64_MAX);
+        b.blitPending = false;
+    }
+}
+
+void DestroyBackBuffers()
+{
+    for (auto& b : g_p.back)
+    {
+        WaitBlit(b);
+        b.resource.Reset();
+        if (b.image)
+            vkDestroyImage(g_p.vk, b.image, nullptr);
+        if (b.memory)
+            vkFreeMemory(g_p.vk, b.memory, nullptr);
+        b.image = VK_NULL_HANDLE;
+        b.memory = VK_NULL_HANDLE;
+    }
+}
+
+// The back buffers at width x height: Vulkan images, as D3D12 resources in the PRESENT state.
+// (VKD3D_RESOURCE_PRESENT_STATE_TRANSITION: in that state the image is in PRESENT_SRC_KHR layout,
+// which the stretch starts and ends in.)
+void CreateBackBuffers(uint32_t width, uint32_t height)
+{
+    DestroyBackBuffers();
+    g_p.width = width;
+    g_p.height = height;
+    for (UINT i = 0; i < kBuffers; i++)
+    {
+        BackBuffer& b = g_p.back[i];
+        VkImageCreateInfo ici{ VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+        ici.imageType = VK_IMAGE_TYPE_2D;
+        ici.format = kBackFormat;
+        ici.extent = { width, height, 1 };
+        ici.mipLevels = 1;
+        ici.arrayLayers = 1;
+        ici.samples = VK_SAMPLE_COUNT_1_BIT;
+        ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ici.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                    VK_IMAGE_USAGE_SAMPLED_BIT;
+        ici.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        CheckVk(vkCreateImage(g_p.vk, &ici, nullptr, &b.image), "vkCreateImage(back buffer)");
+        VkMemoryRequirements req;
+        vkGetImageMemoryRequirements(g_p.vk, b.image, &req);
+        VkMemoryAllocateInfo mai{ VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = MemoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        CheckVk(vkAllocateMemory(g_p.vk, &mai, nullptr, &b.memory), "vkAllocateMemory(back buffer)");
+        CheckVk(vkBindImageMemory(g_p.vk, b.image, b.memory, 0), "vkBindImageMemory(back buffer)");
+
+        vkd3d_image_resource_create_info ri{};
+        ri.type = VKD3D_STRUCTURE_TYPE_IMAGE_RESOURCE_CREATE_INFO;
+        ri.vk_image = b.image;
+        ri.desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        ri.desc.Width = width;
+        ri.desc.Height = height;
+        ri.desc.DepthOrArraySize = 1;
+        ri.desc.MipLevels = 1;
+        ri.desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        ri.desc.SampleDesc.Count = 1;
+        ri.desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+        ri.desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        ri.flags = VKD3D_RESOURCE_INITIAL_STATE_TRANSITION | VKD3D_RESOURCE_PRESENT_STATE_TRANSITION;
+        ri.present_state = D3D12_RESOURCE_STATE_PRESENT;
+        Check(vkd3d_create_image_resource(g_device.Get(), &ri, b.resource.ReleaseAndGetAddressOf()), "vkd3d_create_image_resource");
+
+        D3D12_CPU_DESCRIPTOR_HANDLE h = g_p.rtvHeap->GetCPUDescriptorHandleForHeapStart();
+        h.ptr += SIZE_T(i) * g_p.rtvStride;
+        g_device->CreateRenderTargetView(b.resource.Get(), nullptr, h);
+    }
+    g_p.current = 0;
+    Log("presenter: back buffers %ux%u", width, height);
+}
+
+void DestroySwapchain()
+{
+    for (VkSemaphore s : g_p.rendered)
+        vkDestroySemaphore(g_p.vk, s, nullptr);
+    g_p.rendered.clear();
+    g_p.swapImages.clear();
+    if (g_p.swapchain)
+        vkDestroySwapchainKHR(g_p.vk, g_p.swapchain, nullptr);
+    g_p.swapchain = VK_NULL_HANDLE;
+}
+
+// The window's swap chain (again after a resize). Vsync: FIFO; off: mailbox, else immediate.
+bool CreateSwapchain()
+{
+    VkSurfaceCapabilitiesKHR caps;
+    CheckVk(vkGetPhysicalDeviceSurfaceCapabilitiesKHR(g_p.physical, g_p.surface, &caps), "surface capabilities");
+    VkExtent2D extent = caps.currentExtent;
+    if (extent.width == 0xFFFFFFFFu)
+    {
+        uint32_t w = g_p.width, h = g_p.height;
+        if (GetSettings().windowPixelSize)
+            GetSettings().windowPixelSize(w, h);
+        extent = { w, h };
+    }
+    extent.width = std::clamp(extent.width, caps.minImageExtent.width, caps.maxImageExtent.width);
+    extent.height = std::clamp(extent.height, caps.minImageExtent.height, caps.maxImageExtent.height);
+    if (!extent.width || !extent.height)
+        return false; // minimised
+
+    uint32_t count = 0;
+    vkGetPhysicalDeviceSurfaceFormatsKHR(g_p.physical, g_p.surface, &count, nullptr);
+    std::vector<VkSurfaceFormatKHR> formats(count);
+    vkGetPhysicalDeviceSurfaceFormatsKHR(g_p.physical, g_p.surface, &count, formats.data());
+    VkSurfaceFormatKHR format = formats.empty() ? VkSurfaceFormatKHR{ VK_FORMAT_B8G8R8A8_UNORM, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR } : formats[0];
+    for (const auto& f : formats) // UNORM, like the D3D12 swap chain (the game's output is already gamma)
+        if ((f.format == VK_FORMAT_B8G8R8A8_UNORM || f.format == VK_FORMAT_R8G8B8A8_UNORM) && f.colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR)
+        {
+            format = f;
+            break;
+        }
+
+    const bool vsync = GetSettings().vsync;
+    vkGetPhysicalDeviceSurfacePresentModesKHR(g_p.physical, g_p.surface, &count, nullptr);
+    std::vector<VkPresentModeKHR> modes(count);
+    vkGetPhysicalDeviceSurfacePresentModesKHR(g_p.physical, g_p.surface, &count, modes.data());
+    const auto has = [&](VkPresentModeKHR m) { return std::find(modes.begin(), modes.end(), m) != modes.end(); };
+    VkPresentModeKHR mode = VK_PRESENT_MODE_FIFO_KHR;
+    if (!vsync)
+        mode = has(VK_PRESENT_MODE_MAILBOX_KHR) ? VK_PRESENT_MODE_MAILBOX_KHR
+             : has(VK_PRESENT_MODE_IMMEDIATE_KHR) ? VK_PRESENT_MODE_IMMEDIATE_KHR : VK_PRESENT_MODE_FIFO_KHR;
+
+    VkSwapchainCreateInfoKHR sci{ VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR };
+    sci.surface = g_p.surface;
+    sci.minImageCount = std::max(caps.minImageCount + 1, 3u);
+    if (caps.maxImageCount)
+        sci.minImageCount = std::min(sci.minImageCount, caps.maxImageCount);
+    sci.imageFormat = format.format;
+    sci.imageColorSpace = format.colorSpace;
+    sci.imageExtent = extent;
+    sci.imageArrayLayers = 1;
+    sci.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    sci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    sci.preTransform = (caps.supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR) ? VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR : caps.currentTransform;
+    sci.compositeAlpha = (caps.supportedCompositeAlpha & VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR) ? VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR
+                                                                                            : VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR;
+    sci.presentMode = mode;
+    sci.clipped = VK_TRUE;
+    sci.oldSwapchain = g_p.swapchain;
+    VkSwapchainKHR swapchain;
+    CheckVk(vkCreateSwapchainKHR(g_p.vk, &sci, nullptr, &swapchain), "vkCreateSwapchainKHR");
+    DestroySwapchain();
+    g_p.swapchain = swapchain;
+    g_p.swapFormat = format.format;
+    g_p.swapExtent = extent;
+    g_p.swapVsync = vsync;
+    vkGetSwapchainImagesKHR(g_p.vk, swapchain, &count, nullptr);
+    g_p.swapImages.resize(count);
+    vkGetSwapchainImagesKHR(g_p.vk, swapchain, &count, g_p.swapImages.data());
+    g_p.rendered.resize(count);
+    for (auto& s : g_p.rendered)
+    {
+        VkSemaphoreCreateInfo si{ VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+        CheckVk(vkCreateSemaphore(g_p.vk, &si, nullptr, &s), "vkCreateSemaphore");
+    }
+    Log("presenter: swap chain %ux%u, %u images, %s", extent.width, extent.height, count,
+        mode == VK_PRESENT_MODE_FIFO_KHR ? "vsync" : mode == VK_PRESENT_MODE_MAILBOX_KHR ? "mailbox" : "immediate");
+    return true;
+}
+
+void Barrier(VkCommandBuffer cmd, VkImage image, VkImageLayout from, VkImageLayout to, VkAccessFlags srcAccess, VkAccessFlags dstAccess)
+{
+    VkImageMemoryBarrier b{ VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    b.srcAccessMask = srcAccess;
+    b.dstAccessMask = dstAccess;
+    b.oldLayout = from;
+    b.newLayout = to;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = image;
+    b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+}
+
+// Back buffer i (its frame finished on the GPU) stretched onto the next swap chain image, presented.
+void PresentBuffer(UINT i)
+{
+    BackBuffer& b = g_p.back[i];
+    if (!g_p.swapchain || g_p.swapVsync != GetSettings().vsync)
+    {
+        vkDeviceWaitIdle(g_p.vk);
+        if (!CreateSwapchain())
+            return;
+    }
+    uint32_t index = 0;
+    VkResult r = vkAcquireNextImageKHR(g_p.vk, g_p.swapchain, UINT64_MAX, b.acquired, VK_NULL_HANDLE, &index);
+    if (r == VK_ERROR_OUT_OF_DATE_KHR)
+    {
+        vkDeviceWaitIdle(g_p.vk);
+        CreateSwapchain();
+        return; // the frame is dropped; the next one uses the new swap chain
+    }
+    if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR)
+        CheckVk(r, "vkAcquireNextImageKHR");
+
+    VkCommandBuffer cmd = b.cmd;
+    vkResetCommandBuffer(cmd, 0);
+    VkCommandBufferBeginInfo bi{ VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(cmd, &bi);
+    VkImage dst = g_p.swapImages[index];
+    Barrier(cmd, b.image, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    Barrier(cmd, dst, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+    VkImageBlit blit{};
+    blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    blit.srcOffsets[1] = { int32_t(g_p.width), int32_t(g_p.height), 1 };
+    blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    blit.dstOffsets[1] = { int32_t(g_p.swapExtent.width), int32_t(g_p.swapExtent.height), 1 };
+    vkCmdBlitImage(cmd, b.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
+    Barrier(cmd, b.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_ACCESS_TRANSFER_READ_BIT, 0);
+    Barrier(cmd, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_ACCESS_TRANSFER_WRITE_BIT, 0);
+    vkEndCommandBuffer(cmd);
+
+    const VkPipelineStageFlags waitStage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSubmitInfo si{ VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    si.waitSemaphoreCount = 1;
+    si.pWaitSemaphores = &b.acquired;
+    si.pWaitDstStageMask = &waitStage;
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd;
+    si.signalSemaphoreCount = 1;
+    si.pSignalSemaphores = &g_p.rendered[index];
+    VkPresentInfoKHR pi{ VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+    pi.waitSemaphoreCount = 1;
+    pi.pWaitSemaphores = &g_p.rendered[index];
+    pi.swapchainCount = 1;
+    pi.pSwapchains = &g_p.swapchain;
+    pi.pImageIndices = &index;
+
+    vkResetFences(g_p.vk, 1, &b.blitDone);
+    VkQueue queue = vkd3d_acquire_vk_queue(g_queue.Get()); // vkd3d's queue, locked while we submit
+    CheckVk(vkQueueSubmit(queue, 1, &si, b.blitDone), "vkQueueSubmit(present)");
+    r = vkQueuePresentKHR(queue, &pi);
+    vkd3d_release_vk_queue(g_queue.Get());
+    {
+        std::lock_guard lock(g_p.mutex);
+        b.blitPending = true;
+    }
+    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR)
+    {
+        vkDeviceWaitIdle(g_p.vk);
+        CreateSwapchain();
+    }
+}
+
+void PresentThread()
+{
+    SetThreadDescription(GetCurrentThread(), L"presenter");
+    for (;;)
+    {
+        UINT i;
+        {
+            std::unique_lock lock(g_p.mutex);
+            g_p.cv.wait(lock, [] { return !g_p.pending.empty(); });
+            i = g_p.pending.front();
+            g_p.pending.pop_front();
+            g_p.presenting = int(i);
+        }
+        // The frame drawn into it, finished on the GPU (the stretch is a separate Vulkan submission).
+        if (g_p.fence->GetCompletedValue() < g_p.back[i].frameFence)
+        {
+            g_p.fence->SetEventOnCompletion(g_p.back[i].frameFence, g_p.fenceEvent);
+            WaitForSingleObject(g_p.fenceEvent, INFINITE);
+        }
+        PresentBuffer(i);
+        {
+            std::lock_guard lock(g_p.mutex);
+            g_p.presenting = -1;
+        }
+        g_p.cv.notify_all();
+    }
+}
+
+void Start()
+{
+    EnsureDevice();
+    const Settings& settings = GetSettings();
+    g_p.instance = vkd3d_instance_get_vk_instance(vkd3d_instance_from_device(g_device.Get()));
+    g_p.physical = vkd3d_get_vk_physical_device(g_device.Get());
+    g_p.vk = vkd3d_get_vk_device(g_device.Get());
+    g_p.family = vkd3d_get_vk_queue_family_index(g_queue.Get());
+    g_p.surface = VkSurfaceKHR(settings.createVulkanSurface(g_p.instance));
+    if (!g_p.surface)
+    {
+        Log("presenter: the host gave no Vulkan surface; nothing is shown");
+        return;
+    }
+    VkBool32 supported = VK_FALSE;
+    vkGetPhysicalDeviceSurfaceSupportKHR(g_p.physical, g_p.family, g_p.surface, &supported);
+    if (!supported)
+        Fatal("presenter: the GPU's queue can't present to this window");
+
+    VkCommandPoolCreateInfo pci{ VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = g_p.family;
+    CheckVk(vkCreateCommandPool(g_p.vk, &pci, nullptr, &g_p.pool), "vkCreateCommandPool");
+    for (auto& b : g_p.back)
+    {
+        VkCommandBufferAllocateInfo ai{ VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+        ai.commandPool = g_p.pool;
+        ai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        ai.commandBufferCount = 1;
+        CheckVk(vkAllocateCommandBuffers(g_p.vk, &ai, &b.cmd), "vkAllocateCommandBuffers");
+        VkFenceCreateInfo fi{ VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+        CheckVk(vkCreateFence(g_p.vk, &fi, nullptr, &b.blitDone), "vkCreateFence");
+        VkSemaphoreCreateInfo si{ VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+        CheckVk(vkCreateSemaphore(g_p.vk, &si, nullptr, &b.acquired), "vkCreateSemaphore");
+    }
+
+    D3D12_DESCRIPTOR_HEAP_DESC hd{};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+    hd.NumDescriptors = kBuffers;
+    Check(g_device->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&g_p.rtvHeap)), "CreateDescriptorHeap");
+    g_p.rtvStride = g_device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    Check(g_device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&g_p.fence)), "CreateFence");
+    g_p.fenceEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    CreateBackBuffers(settings.width, settings.height);
+    CreateSwapchain();
+    std::thread(PresentThread).detach();
+    g_p.ready = true;
+    Log("presenter: Vulkan swap chain on the host's window ready");
+}
+} // namespace
+
+void RenderSize(uint32_t& width, uint32_t& height)
+{
+    GetSettings().RenderSize(width, height);
+}
+
+void PresenterInit()
+{
+    if (getenv("REGPU_HEADLESS") || !GetSettings().createVulkanSurface)
+        return;
+    Start();
+}
+
+// Note: the presenter's own frames (before the renderer draws: a pulsing clear, or a CPU image) are
+// Windows only; on Linux the window stays as it is until the renderer's first frame.
+void PresenterSubmitFrame(uint64_t) {}
+void PresenterSubmitImage(uint32_t, uint32_t, std::vector<uint8_t>) {}
+void PresenterUseRenderer() {}
+bool PresenterHasFocus() { return true; } // the host's window: the host handles focus
+void regpu::SetWindowSize(uint32_t, uint32_t) {} // the host sizes its window
+
+ID3D12Device* RenderDevice()
+{
+    EnsureDevice();
+    return g_device.Get();
+}
+
+ID3D12CommandQueue* RenderQueue()
+{
+    EnsureDevice();
+    return g_queue.Get();
+}
+
+// The back buffers to a new output size (the renderer's ApplyOutputSize, the host GPU idle).
+void PresenterResize(uint32_t width, uint32_t height)
+{
+    if (!g_p.ready)
+        return;
+    std::unique_lock lock(g_p.mutex);
+    g_p.cv.wait(lock, [] { return g_p.pending.empty() && g_p.presenting < 0; });
+    lock.unlock();
+    vkDeviceWaitIdle(g_p.vk);
+    CreateBackBuffers(width, height);
+}
+
+bool PresenterRecordCopy(ID3D12GraphicsCommandList* list, ID3D12Resource* src, ID3D12Resource* overlay, uint32_t overlayW, uint32_t overlayH)
+{
+    (void)overlayW;
+    (void)overlayH;
+    if (!g_p.ready)
+        return false;
+    const UINT i = g_p.current;
+    BackBuffer& back = g_p.back[i];
+    // Not presented yet, or still being stretched onto the swap chain: wait for it.
+    {
+        std::unique_lock lock(g_p.mutex);
+        g_p.cv.wait(lock, [&] { return g_p.presenting != int(i) && std::find(g_p.pending.begin(), g_p.pending.end(), i) == g_p.pending.end(); });
+        WaitBlit(back);
+    }
+    ID3D12Resource* backBuffer = back.resource.Get();
+    D3D12_RESOURCE_BARRIER b{};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = backBuffer;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    // As on Windows (render/presenter.cpp): the image in the middle of the back buffer, on black
+    // when it is smaller; the debug overlay at the top left; the host's overlay last.
+    const D3D12_RESOURCE_DESC sd = src->GetDesc(), bd = backBuffer->GetDesc();
+    const UINT offsetX = UINT((bd.Width - std::min(sd.Width, bd.Width)) / 2), offsetY = (bd.Height - std::min(sd.Height, bd.Height)) / 2;
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv = g_p.rtvHeap->GetCPUDescriptorHandleForHeapStart();
+    rtv.ptr += SIZE_T(i) * g_p.rtvStride;
+    if (offsetX || offsetY)
+    {
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        list->ResourceBarrier(1, &b);
+        const float black[4] = { 0, 0, 0, 1 };
+        list->ClearRenderTargetView(rtv, black, 0, nullptr);
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    }
+    list->ResourceBarrier(1, &b);
+    if (!offsetX && !offsetY && sd.Width == bd.Width && sd.Height == bd.Height)
+        list->CopyResource(backBuffer, src);
+    else
+    {
+        D3D12_TEXTURE_COPY_LOCATION dst{}, from{};
+        dst.pResource = backBuffer;
+        dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        from.pResource = src;
+        from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        const D3D12_BOX box{ 0, 0, 0, UINT(std::min(sd.Width, bd.Width)), std::min(sd.Height, bd.Height), 1 };
+        list->CopyTextureRegion(&dst, offsetX, offsetY, 0, &from, &box);
+    }
+    if (overlay)
+    {
+        D3D12_TEXTURE_COPY_LOCATION dst{}, from{};
+        dst.pResource = backBuffer;
+        dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        from.pResource = overlay;
+        from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        list->CopyTextureRegion(&dst, offsetX + 24, offsetY + 24, 0, &from, nullptr);
+    }
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    if (const auto drawOverlay = regpu::GetHost().drawOverlay)
+    {
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        list->ResourceBarrier(1, &b);
+        drawOverlay(list, backBuffer, rtv.ptr, UINT(bd.Width), bd.Height);
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    }
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+    list->ResourceBarrier(1, &b);
+    return true;
+}
+
+// The renderer executed the list from PresenterRecordCopy: mark the frame on the queue and hand
+// the back buffer to the presenter thread.
+void PresenterPresent()
+{
+    if (!g_p.ready)
+        return;
+    const UINT i = g_p.current;
+    const uint64_t value = g_p.nextFence++;
+    g_queue->Signal(g_p.fence.Get(), value);
+    {
+        std::lock_guard lock(g_p.mutex);
+        g_p.back[i].frameFence = value;
+        g_p.pending.push_back(i);
+    }
+    g_p.cv.notify_all();
+    g_p.current = (i + 1) % kBuffers;
+}
+
+// Note: the host knows its display; 60 until the Linux plugin reports the refresh rate.
+uint32_t DisplayRefreshHz()
+{
+    return 60;
+}
