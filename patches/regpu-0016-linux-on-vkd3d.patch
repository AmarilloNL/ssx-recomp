diff --git a/src/platform/linux/d3dcompile_linux.cpp b/src/platform/linux/d3dcompile_linux.cpp
new file mode 100644
index 0000000..bfe697a
--- /dev/null
+++ b/src/platform/linux/d3dcompile_linux.cpp
@@ -0,0 +1,37 @@
+// Linux: D3DCompile through DXC (regpu_win32.h points ReGPU's calls here). Shader model 5 targets
+// become 6.0: DXIL, which vkd3d reads (its own HLSL compiler lacks SM 5.1 resource arrays).
+#include <windows.h>
+
+#include <cstring>
+#include <string>
+
+#include "platform/linux/dxc_compile.h"
+
+HRESULT RegpuD3DCompile(const void* source, SIZE_T size, const char*, const D3D_SHADER_MACRO* defines, ID3DInclude*,
+    const char* entry, const char* target, UINT, UINT, ID3DBlob** code, ID3DBlob** errorBlob)
+{
+    std::string profile = target ? target : "";
+    if (profile.size() >= 6 && profile[3] == '5') // vs_5_0, ps_5_1, cs_5_1 ...
+        profile = profile.substr(0, 3) + "6_0";
+    std::vector<std::pair<std::string, std::string>> defs;
+    for (const D3D_SHADER_MACRO* d = defines; d && d->Name; ++d)
+        defs.emplace_back(d->Name, d->Definition ? d->Definition : "1");
+
+    std::vector<uint8_t> bytes;
+    std::string errors;
+    const bool ok = RegpuDxcCompile(source, size, entry ? entry : "main", profile.c_str(), defs, bytes, errors);
+    if (errorBlob)
+    {
+        *errorBlob = nullptr;
+        if (!errors.empty() && SUCCEEDED(D3DCreateBlob(errors.size() + 1, errorBlob)))
+            std::memcpy((*errorBlob)->GetBufferPointer(), errors.c_str(), errors.size() + 1);
+    }
+    if (code)
+        *code = nullptr;
+    if (!ok)
+        return E_FAIL;
+    if (!code || FAILED(D3DCreateBlob(bytes.size(), code)))
+        return E_OUTOFMEMORY;
+    std::memcpy((*code)->GetBufferPointer(), bytes.data(), bytes.size());
+    return S_OK;
+}
