 inline void PreciseSleepUntil(std::chrono::steady_clock::time_point deadline, int64_t spinUs = 0)
 {
     using namespace std::chrono;
+#ifndef _WIN32
+    // Linux: clock_nanosleep on the monotonic clock (steady_clock's) is already exact to tens of
+    // microseconds.
+    auto left = duration_cast<nanoseconds>(deadline - steady_clock::now()).count();
+    if (left <= 0)
+        return;
+    if (left > spinUs * 1000)
+    {
+        const auto until = duration_cast<nanoseconds>((deadline - microseconds(spinUs)).time_since_epoch()).count();
+        timespec ts{ time_t(until / 1000000000), long(until % 1000000000) };
+        while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, nullptr) == EINTR) {}
+    }
+    while (steady_clock::now() < deadline)
+        YieldProcessor();
+#else
     thread_local HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
     auto left = duration_cast<microseconds>(deadline - steady_clock::now()).count();
     if (left <= 0)
@@ -31,4 +46,5 @@ inline void PreciseSleepUntil(std::chrono::steady_clock::time_point deadline, in
     }
     while (steady_clock::now() < deadline)
         YieldProcessor();
+#endif
 }
