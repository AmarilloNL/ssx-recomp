+#pragma once
+// Linux: the Windows and Direct3D 12 API ReGPU uses, on top of vkd3d (Direct3D 12 on Vulkan, by
+// WineHQ). The stand-in headers next to this one (windows.h, d3d12.h, wrl/client.h, ...) all
+// include it, so ReGPU's sources build unchanged.
+//
+// vkd3d's COM interfaces use the Windows calling convention (ms_abi) and, with
+// WIDL_EXPLICIT_AGGREGATE_RETURNS, the MSVC way of returning structs from methods
+// (GetCPUDescriptorHandleForHeapStart, GetDesc): its own headers are needed, not the DirectX-Headers.
+#ifndef WIDL_EXPLICIT_AGGREGATE_RETURNS
+#define WIDL_EXPLICIT_AGGREGATE_RETURNS
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX // (vkd3d_windows.h's min/max macros break the standard headers)
+#endif
+#include <vkd3d_windows.h>
+#include <vkd3d_d3d12.h>
+#include <vkd3d_d3d12sdklayers.h>
+#include <vkd3d_d3dcommon.h>
+#include <vkd3d_dxgiformat.h>
+#include <vkd3d_utils.h>
+#undef min
+#undef max
+
+#include <pthread.h>
+#include <sched.h>
+#include <time.h>
+#include <unistd.h>
+#include <immintrin.h>
+
+#include <cerrno>
+#include <chrono>
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+#include <utility>
+
+// ---------------------------------------------------------------------------- COM helpers
+#ifndef IID_PPV_ARGS
+#define IID_PPV_ARGS(pp) __uuidof(**(pp)), reinterpret_cast<void**>(pp)
+#endif
+
+namespace Microsoft::WRL {
+// The part of WRL's ComPtr ReGPU uses.
+template <typename T>
+class ComPtr
+{
+public:
+    using InterfaceType = T;
+    ComPtr() = default;
+    ComPtr(std::nullptr_t) {}
+    ComPtr(T* p) : p_(p) { if (p_) p_->AddRef(); }
+    ComPtr(const ComPtr& o) : p_(o.p_) { if (p_) p_->AddRef(); }
+    ComPtr(ComPtr&& o) noexcept : p_(std::exchange(o.p_, nullptr)) {}
+    template <typename U>
+    ComPtr(const ComPtr<U>& o) : p_(o.Get()) { if (p_) p_->AddRef(); }
+    ~ComPtr() { Reset(); }
+    ComPtr& operator=(const ComPtr& o) { ComPtr(o).Swap(*this); return *this; }
+    ComPtr& operator=(ComPtr&& o) noexcept { ComPtr(std::move(o)).Swap(*this); return *this; }
+    ComPtr& operator=(T* p) { ComPtr(p).Swap(*this); return *this; }
+    ComPtr& operator=(std::nullptr_t) { Reset(); return *this; }
+    T* Get() const { return p_; }
+    T* operator->() const { return p_; }
+    explicit operator bool() const { return p_ != nullptr; }
+    T** GetAddressOf() { return &p_; }
+    T* const* GetAddressOf() const { return &p_; }
+    T** ReleaseAndGetAddressOf() { Reset(); return &p_; }
+    T** operator&() { return ReleaseAndGetAddressOf(); }
+    unsigned long Reset() { unsigned long n = 0; if (p_) n = std::exchange(p_, nullptr)->Release(); return n; }
+    void Attach(T* p) { Reset(); p_ = p; }
+    T* Detach() { return std::exchange(p_, nullptr); }
+    void Swap(ComPtr& o) { std::swap(p_, o.p_); }
+    HRESULT CopyTo(T** out) const { if (p_) p_->AddRef(); *out = p_; return S_OK; }
+    template <typename U>
+    HRESULT As(ComPtr<U>* out) const { return p_->QueryInterface(__uuidof(U), reinterpret_cast<void**>(out->ReleaseAndGetAddressOf())); }
+    template <typename U>
+    HRESULT As(ComPtr<U>& out) const { return As(&out); }
+    bool operator==(const ComPtr& o) const { return p_ == o.p_; }
+    bool operator==(std::nullptr_t) const { return p_ == nullptr; }
+private:
+    T* p_ = nullptr;
+};
+} // namespace Microsoft::WRL
+
+// ---------------------------------------------------------------------------- shader compiler
+// DXC instead of vkd3d-utils' D3DCompile (d3dcompile_linux.cpp).
+HRESULT RegpuD3DCompile(const void* source, SIZE_T size, const char* name, const D3D_SHADER_MACRO* defines,
+    ID3DInclude* include, const char* entry, const char* target, UINT flags1, UINT flags2, ID3DBlob** code, ID3DBlob** errors);
+#define D3DCompile RegpuD3DCompile
+#ifndef D3DCOMPILE_SKIP_OPTIMIZATION
+#define D3DCOMPILE_SKIP_OPTIMIZATION (1u << 2)
+#define D3DCOMPILE_OPTIMIZATION_LEVEL1 0u
+#define D3DCOMPILE_OPTIMIZATION_LEVEL3 (1u << 15)
+#define D3DCOMPILE_ENABLE_UNBOUNDED_DESCRIPTOR_TABLES (1u << 20)
+#endif
+
+// ---------------------------------------------------------------------------- Win32
+#ifndef INFINITE
+#define INFINITE 0xFFFFFFFFu
+#endif
+#ifndef WAIT_OBJECT_0
+#define WAIT_OBJECT_0 0u
+#endif
+#ifndef WAIT_TIMEOUT
+#define WAIT_TIMEOUT 0x102u
+#endif
+#ifndef WAIT_FAILED
+#define WAIT_FAILED 0xFFFFFFFFu
+#endif
+#define THREAD_PRIORITY_LOWEST -2
+#define THREAD_PRIORITY_BELOW_NORMAL -1
+#define THREAD_PRIORITY_NORMAL 0
+#define THREAD_PRIORITY_ABOVE_NORMAL 1
+#define THREAD_PRIORITY_HIGHEST 2
+#define THREAD_PRIORITY_TIME_CRITICAL 15
+#define DUPLICATE_SAME_ACCESS 2
+
+// Events are vkd3d-utils' (auto-reset), so ID3D12Fence::SetEventOnCompletion can signal them.
+inline HANDLE CreateEventW(void*, BOOL manualReset, BOOL initialState, const void*)
+{
+    HANDLE e = vkd3d_create_event();
+    (void)manualReset; // ReGPU only uses auto-reset events
+    if (e && initialState) vkd3d_signal_event(e);
+    return e;
+}
+inline BOOL SetEvent(HANDLE e) { return SUCCEEDED(vkd3d_signal_event(e)); }
+inline DWORD WaitForSingleObject(HANDLE e, DWORD ms) { return vkd3d_wait_event(e, ms); }
+inline BOOL CloseHandle(HANDLE e) { if (e) vkd3d_destroy_event(e); return TRUE; }
+
+inline void Sleep(DWORD ms)
+{
+    if (ms == 0) sched_yield();
+    else std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+}
+inline uint64_t GetTickCount64()
+{
+    return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+#define YieldProcessor() _mm_pause()
+
+// Thread handles are only used for names, priorities and profiling.
+inline HANDLE GetCurrentThread() { return reinterpret_cast<HANDLE>(-2); }
+inline HANDLE GetCurrentProcess() { return reinterpret_cast<HANDLE>(-1); }
+inline BOOL SetThreadPriority(HANDLE, int) { return TRUE; } // Note: Linux threads keep their priority
+inline BOOL DuplicateHandle(HANDLE, HANDLE, HANDLE, HANDLE* out, DWORD, BOOL, DWORD) { if (out) *out = nullptr; return FALSE; }
+inline HRESULT SetThreadDescription(HANDLE, const wchar_t* name)
+{
+    char narrow[16] = {}; // Linux thread names: 15 characters
+    for (int i = 0; i < 15 && name[i]; ++i) narrow[i] = char(name[i] < 128 ? name[i] : '?');
+    pthread_setname_np(pthread_self(), narrow);
+    return S_OK;
+}
+inline BOOL SwitchToThread() { return sched_yield() == 0; }
+inline DWORD GetCurrentThreadId() { return DWORD(gettid()); }
+
+// The one feature ReGPU asks for: 40, PF_AVX2_INSTRUCTIONS_AVAILABLE.
+inline BOOL IsProcessorFeaturePresent(DWORD feature) { return feature == 40 && __builtin_cpu_supports("avx2"); }
+
+// A path's c_str() is char on Linux; the mode is still written as L"w".
+inline FILE* _wfopen(const char* path, const wchar_t* mode)
+{
+    char m[8] = {};
+    for (int i = 0; i < 7 && mode[i]; ++i) m[i] = char(mode[i]);
+    return std::fopen(path, m);
+}
+inline int _putenv_s(const char* name, const char* value) { return *value ? setenv(name, value, 1) : unsetenv(name); }
+inline BOOL SetEnvironmentVariableA(const char*, const char*) { return TRUE; } // (_putenv_s did it)
+
+// ---------------------------------------------------------------------------- VirtualQuery
+// ReGPU asks whether guest memory is committed and readable before reading it (ReXGlue commits
+// guest memory on demand). On Linux the runtime maps reserved memory with no access and committed
+// memory read-write, so /proc/self/maps answers it. BaseAddress is the start of the mapping, which
+// the callers handle like Windows' page-rounded address (both measure RegionSize from it).
+struct MEMORY_BASIC_INFORMATION
+{
+    void* BaseAddress;
+    void* AllocationBase;
+    DWORD AllocationProtect;
+    SIZE_T RegionSize;
+    DWORD State;
+    DWORD Protect;
+    DWORD Type;
+};
+#define MEM_COMMIT 0x1000u
+#define MEM_RESERVE 0x2000u
+#define MEM_FREE 0x10000u
+#define PAGE_NOACCESS 0x01u
+#define PAGE_READONLY 0x02u
+#define PAGE_READWRITE 0x04u
+#define PAGE_WRITECOPY 0x08u
+#define PAGE_EXECUTE_READ 0x20u
+#define PAGE_EXECUTE_READWRITE 0x40u
+#define PAGE_GUARD 0x100u
+inline SIZE_T VirtualQuery(const void* address, MEMORY_BASIC_INFORMATION* info, SIZE_T)
+{
+    FILE* f = std::fopen("/proc/self/maps", "r");
+    if (!f)
+        return 0;
+    const uintptr_t a = uintptr_t(address);
+    *info = {};
+    bool found = false;
+    char line[512];
+    while (!found && std::fgets(line, sizeof(line), f))
+    {
+        unsigned long lo, hi;
+        char perms[5] = {};
+        if (std::sscanf(line, "%lx-%lx %4s", &lo, &hi, perms) != 3 || a >= hi)
+            continue;
+        found = true;
+        if (a < lo) // in the gap before this mapping: nothing there
+        {
+            info->BaseAddress = reinterpret_cast<void*>(a & ~uintptr_t(0xFFF));
+            info->RegionSize = lo - uintptr_t(info->BaseAddress);
+            info->State = MEM_FREE;
+            info->Protect = PAGE_NOACCESS;
+            break;
+        }
+        const bool r = perms[0] == 'r', w = perms[1] == 'w', x = perms[2] == 'x';
+        info->BaseAddress = info->AllocationBase = reinterpret_cast<void*>(lo);
+        info->RegionSize = hi - lo;
+        info->State = (r || w || x) ? MEM_COMMIT : MEM_RESERVE;
+        info->Protect = !(r || w || x) ? PAGE_NOACCESS : x ? (w ? PAGE_EXECUTE_READWRITE : PAGE_EXECUTE_READ) : (w ? PAGE_READWRITE : PAGE_READONLY);
+    }
+    std::fclose(f);
+    return found ? sizeof(*info) : 0;
+}
