diff --git a/src/platform/linux/dxc_compile.cpp b/src/platform/linux/dxc_compile.cpp
new file mode 100644
index 0000000..a73c286
--- /dev/null
+++ b/src/platform/linux/dxc_compile.cpp
@@ -0,0 +1,46 @@
+// Linux: DXC as a library (see dxc_compile.h). One compiler per thread: DXC's instances are not
+// thread-safe, and ReGPU compiles on several threads.
+#include "platform/linux/dxc_compile.h"
+
+#include <dxc/dxcapi.h>
+
+bool RegpuDxcCompile(const void* source, size_t size, const char* entry, const char* profile,
+    const std::vector<std::pair<std::string, std::string>>& defines, std::vector<uint8_t>& code, std::string& errors)
+{
+    thread_local CComPtr<IDxcCompiler3> compiler;
+    if (!compiler && FAILED(DxcCreateInstance(CLSID_DxcCompiler, IID_PPV_ARGS(&compiler))))
+    {
+        errors = "DXC (libdxcompiler.so) could not be loaded";
+        return false;
+    }
+    const auto wide = [](const std::string& s) { return std::wstring(s.begin(), s.end()); };
+    // HLSL 2021 (the default): the generated HLSL writes per-component logic for it (hlsl.cpp, REGPU_SEL).
+    std::vector<std::wstring> args = { L"-E", wide(entry), L"-T", wide(profile), L"-O3" };
+    for (const auto& [name, value] : defines)
+    {
+        args.push_back(L"-D");
+        args.push_back(wide(name + "=" + value));
+    }
+    std::vector<LPCWSTR> argv;
+    for (const auto& a : args)
+        argv.push_back(a.c_str());
+
+    DxcBuffer buffer{ source, size, DXC_CP_UTF8 };
+    CComPtr<IDxcResult> result;
+    if (FAILED(compiler->Compile(&buffer, argv.data(), UINT32(argv.size()), nullptr, IID_PPV_ARGS(&result))) || !result)
+    {
+        errors = "DXC failed to run";
+        return false;
+    }
+    CComPtr<IDxcBlobUtf8> messages;
+    if (SUCCEEDED(result->GetOutput(DXC_OUT_ERRORS, IID_PPV_ARGS(&messages), nullptr)) && messages && messages->GetStringLength())
+        errors.assign(messages->GetStringPointer(), messages->GetStringLength());
+    HRESULT status = E_FAIL;
+    result->GetStatus(&status);
+    CComPtr<IDxcBlob> object;
+    if (FAILED(status) || FAILED(result->GetOutput(DXC_OUT_OBJECT, IID_PPV_ARGS(&object), nullptr)) || !object)
+        return false;
+    const auto* bytes = static_cast<const uint8_t*>(object->GetBufferPointer());
+    code.assign(bytes, bytes + object->GetBufferSize());
+    return true;
+}
diff --git a/src/platform/linux/dxc_compile.h b/src/platform/linux/dxc_compile.h
new file mode 100644
index 0000000..aa83c24
--- /dev/null
+++ b/src/platform/linux/dxc_compile.h
@@ -0,0 +1,13 @@
+#pragma once
+// Linux: HLSL to DXIL with DXC (libdxcompiler.so), which vkd3d translates to SPIR-V. A plain C++
+// interface: DXC's COM headers (System V calling convention) can't share a file with vkd3d's.
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+// profile: a shader model 6 target (ps_6_0, vs_6_0, cs_6_0). errors gets the compiler's messages,
+// also warnings on success.
+bool RegpuDxcCompile(const void* source, size_t size, const char* entry, const char* profile,
+    const std::vector<std::pair<std::string, std::string>>& defines, std::vector<uint8_t>& code, std::string& errors);
