new file mode 100644
index 0000000..c4c5430
--- /dev/null
+++ b/src/platform/linux/include/DirectXPackedVector.h
@@ -0,0 +1,14 @@
+#pragma once
+// Linux stand-in for the one DirectXMath function ReGPU uses: float to IEEE half (clang's _Float16,
+// which needs no F16C instructions).
+#include <cstdint>
+#include <cstring>
+namespace DirectX::PackedVector {
+inline uint16_t XMConvertFloatToHalf(float f)
+{
+    const _Float16 h = static_cast<_Float16>(f);
+    uint16_t bits;
+    std::memcpy(&bits, &h, sizeof(bits));
+    return bits;
+}
+} // namespace DirectX::PackedVector
