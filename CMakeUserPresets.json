{
    "version": 6,
    "configurePresets": [
        {
            "name": "ssx",
            "displayName": "SSX dev (SDK built from tools/rexglue-src)",
            "inherits": "win-amd64-relwithdebinfo",
            "binaryDir": "${sourceDir}/out/build/ssx",
            "cacheVariables": {
                "REXSDK_DIR": "${sourceDir}/tools/rexglue-src",
                "REXGLUE_ENABLE_FIDELITYFX": "ON"
            }
        },
        {
            "name": "ssx-release",
            "displayName": "SSX release (SDK built from tools/rexglue-src)",
            "inherits": "win-amd64-release",
            "binaryDir": "${sourceDir}/out/build/ssx-release",
            "cacheVariables": {
                "REXSDK_DIR": "${sourceDir}/tools/rexglue-src",
                "REXGLUE_ENABLE_FIDELITYFX": "ON"
            }
        },
        {
            "name": "ssx-player",
            "displayName": "SSX release (prebuilt SDK package in tools/rexglue-sdk-ssx)",
            "inherits": "win-amd64-release",
            "binaryDir": "${sourceDir}/out/build/ssx-player",
            "cacheVariables": {
                "REXSDK_DIR": "",
                "CMAKE_PREFIX_PATH": "${sourceDir}/tools/rexglue-sdk-ssx"
            }
        },
        {
            "name": "ssx-linux",
            "displayName": "SSX release for Linux (SDK built by scripts/build-ssx-linux.sh in tools/rexglue-sdk-ssx)",
            "inherits": "linux-amd64-release",
            "binaryDir": "${sourceDir}/out/build/ssx-linux",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "REXSDK_DIR": "",
                "CMAKE_PREFIX_PATH": "${sourceDir}/tools/rexglue-sdk-ssx"
            }
        }
    ]
}
